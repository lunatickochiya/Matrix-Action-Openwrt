From efc531871b0cbb8abe271a17b85ce1494250a5cb Mon Sep 17 00:00:00 2001
From: Liangbin Lian <jjm2473@gmail.com>
Date: Fri, 7 Feb 2025 20:34:04 +0800
Subject: [PATCH] kernel: fix dma-buf build into kernel

---
 .../hack-6.6/905-fix_dma_buf_heaps.patch      | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)
 create mode 100644 target/linux/generic/hack-6.6/905-fix_dma_buf_heaps.patch

diff --git a/target/linux/generic/hack-6.6/905-fix_dma_buf_heaps.patch b/target/linux/generic/hack-6.6/905-fix_dma_buf_heaps.patch
new file mode 100644
index 0000000000..5bc2b68582
--- /dev/null
+++ b/target/linux/generic/hack-6.6/905-fix_dma_buf_heaps.patch
@@ -0,0 +1,27 @@
+From 9fc8599a1d3c155c29324f2b3a50e488aadd1e4a Mon Sep 17 00:00:00 2001
+From: jjm2473 <jjm2473@gmail.com>
+Date: Fri, 7 Feb 2025 20:29:45 +0800
+Subject: [PATCH] drivers/dma-buf: fix build system_heap and cma_heap when
+ CONFIG_DMA_SHARED_BUFFER=y
+
+Fixes: "debloat: dmabuf"
+---
+ drivers/dma-buf/heaps/Makefile | 5 +++++
+ 1 file changed, 5 insertions(+)
+
+diff --git a/drivers/dma-buf/heaps/Makefile b/drivers/dma-buf/heaps/Makefile
+index 87f71c3ee..ba782394f 100644
+--- a/drivers/dma-buf/heaps/Makefile
++++ b/drivers/dma-buf/heaps/Makefile
+@@ -1,3 +1,8 @@
+ # SPDX-License-Identifier: GPL-2.0
++ifeq ($(CONFIG_DMA_SHARED_BUFFER),y)
++obj-$(CONFIG_DMABUF_HEAPS_SYSTEM)	+= system_heap.o
++obj-$(CONFIG_DMABUF_HEAPS_CMA)		+= cma_heap.o
++else
+ dma-buf-objs-$(CONFIG_DMABUF_HEAPS_SYSTEM)	+= system_heap.o
+ dma-buf-objs-$(CONFIG_DMABUF_HEAPS_CMA)		+= cma_heap.o
++endif
+-- 
+2.46.0
+
