#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1

start_instance() {
	local cfg="$1" param
	config_get_bool enabled $cfg enabled 1
	echo "opencode2api-go=$enabled"
	[ "$enabled" = "1" ] || return 1
	echo "开始启动..."
	config_get PROG "$cfg" prog_path "/usr/bin/opencode2api"
	config_get port $cfg port '8000'
	config_get config_path $cfg config_path '/etc/opencode2api-go/config.json'
	config_get admin_password $cfg admin_password '123456'
	config_get_bool debug $cfg debug 0
	config_get_bool fwan $cfg fwan 0
	config_get log_level $cfg log_level 'info'
	config_get log_file $cfg log_file '/var/log/opencode2api-go.log'

	[ -x "$PROG" ] || chmod +x $PROG

	# 创建必要目录
	[ -n "$config_path" ] && mkdir -p "$(dirname "$config_path")" 2>/dev/null

	local cmd="$PROG"
	[ -n "$port" ] && cmd="$cmd -port $port"
	[ -n "$config_path" ] && cmd="$cmd -config $config_path"
	[ -n "$admin_password" ] && cmd="$cmd -password '$admin_password'"
	[ "$debug" = "1" ] && cmd="$cmd -debug"
	cmd="$cmd -log-file $log_file"
	cmd="$cmd -log-stdout=false"

	echo "$(date '+%Y/%m/%d %H:%M:%S') 开始启动" >/var/log/opencode2api-go.start.log
	procd_open_instance opencode2api-go
	procd_set_param command /bin/sh -c "exec $cmd"
	procd_set_param respawn
	procd_close_instance

	if [ "$fwan" = "1" ]; then
		echo "$(date '+%Y/%m/%d %H:%M:%S') 防火墙放行${port}访问" >>/var/log/opencode2api-go.start.log
		uci -q delete firewall.opencode2api-go
		uci set firewall.opencode2api-go=rule
		uci set firewall.opencode2api-go.name="opencode2api-go"
		uci set firewall.opencode2api-go.target="ACCEPT"
		uci set firewall.opencode2api-go.src="wan"
		uci set firewall.opencode2api-go.proto="tcp"
		uci set firewall.opencode2api-go.dest_port="$port"
		uci set firewall.opencode2api-go.enabled="1"
		[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
	fi
	echo "done"
}

start_service() {
	config_load 'opencode2api-go'
	config_foreach start_instance 'opencode2api-go'
}

stop_service() {
	echo "$(date '+%Y/%m/%d %H:%M:%S') 停止运行" >>/var/log/opencode2api-go.start.log
	uci -q delete firewall.opencode2api-go
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger "opencode2api-go"
}